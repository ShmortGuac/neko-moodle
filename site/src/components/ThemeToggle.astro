---
// Light/dark switch. The first visit follows the system setting; a click picks the other mode and remembers it
// (data-theme on <html>, saved in localStorage when the browser allows it).
---

<button type="button" class="theme-toggle" id="themeToggle" aria-label="Switch to dark mode" title="Switch to dark mode">
  <svg class="theme-toggle__sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
  <svg class="theme-toggle__moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z" />
  </svg>
</button>

<script>
  const KEY = 'neko-site-theme';
  const root = document.documentElement;
  const button = document.getElementById('themeToggle');
  const system = window.matchMedia('(prefers-color-scheme: dark)');
  const current = () => (root.dataset.theme === 'light' || root.dataset.theme === 'dark' ? root.dataset.theme : system.matches ? 'dark' : 'light');

  const label = () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    button?.setAttribute('aria-label', `Switch to ${next} mode`);
    button?.setAttribute('title', `Switch to ${next} mode`);
  };

  button?.addEventListener('click', () => {
    const next = current() === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem(KEY, next);
    } catch {}
    label();
  });
  system.addEventListener('change', label);
  label();
</script>

<style>
  .theme-toggle {
    width: 40px; height: 40px; display: grid; place-items: center; flex: none;
    border-radius: 50%; border: 1px solid var(--border); background: var(--surface); color: var(--text);
    cursor: pointer; transition: transform 0.15s, box-shadow 0.15s;
  }
  .theme-toggle:hover { transform: translateY(-1px); box-shadow: var(--shadow-sm); }
  .theme-toggle svg { width: 20px; height: 20px; grid-area: 1 / 1; transition: opacity 0.2s, transform 0.3s; }
  /* Shows the mode you'd switch to: a moon in light mode, a sun in dark mode. */
  .theme-toggle__sun { opacity: 0; transform: rotate(-60deg) scale(0.6); }
  :global(:root[data-theme="dark"]) .theme-toggle__sun { opacity: 1; transform: none; }
  :global(:root[data-theme="dark"]) .theme-toggle__moon { opacity: 0; transform: rotate(60deg) scale(0.6); }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle__sun { opacity: 1; transform: none; }
    :global(:root:not([data-theme="light"])) .theme-toggle__moon { opacity: 0; transform: rotate(60deg) scale(0.6); }
  }
</style>
