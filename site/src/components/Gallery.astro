---
// Screenshots of NEKO with sample data (made-up student and school). The first one is shown large.
// Clicking one opens it full-size; arrow keys move between them and Esc closes.
import { Image, getImage } from 'astro:assets';
import editor from '../assets/shots/editor.png';
import dashboard from '../assets/shots/dashboard.png';
import course from '../assets/shots/course.png';
import assignment from '../assets/shots/assignment.png';
import forum from '../assets/shots/forum.png';
import courses from '../assets/shots/courses.png';

const shots = [
  { img: editor, title: 'Theme editor', text: 'Change colours, fonts and pictures and watch the real pages update.', theme: 'Sakura' },
  { img: dashboard, title: 'Dashboard', text: 'What’s due, the latest news and your progress at a glance.', theme: 'Light' },
  { img: course, title: 'Course page', text: 'Sections, files and activities. View PDFs or download everything at once.', theme: 'Dark' },
  { img: assignment, title: 'Assignments', text: 'Due dates, status, grade and feedback, and your submission.', theme: 'Light' },
  { img: forum, title: 'Forums', text: 'Threaded discussions with attachments and replies.', theme: 'Dark' },
  { img: courses, title: 'Courses', text: 'Every course with progress, search and current/past filters.', theme: 'Sakura' },
];
const full = await Promise.all(shots.map((s) => getImage({ src: s.img, width: 2000, format: 'webp' })));
---

<div class="gallery">
  {shots.map((s, i) => (
    <figure class:list={['shot', i === 0 && 'shot--feature']}>
      <button type="button" class="shot__open" data-shot={i} aria-label={`Open the ${s.title} screenshot`}>
        <Image
          src={s.img}
          alt={`${s.title}: ${s.text}`}
          widths={i === 0 ? [640, 1000, 1400, 2000] : [480, 760, 1100]}
          sizes={i === 0 ? '(max-width: 1120px) 100vw, 1120px' : '(max-width: 720px) 100vw, (max-width: 980px) 50vw, 360px'}
          loading="lazy"
        />
      </button>
      <figcaption>
        <b>{s.title}</b>
        <span>{s.text}</span>
        <small>{s.theme}</small>
      </figcaption>
    </figure>
  ))}
</div>
<p class="gallery__note">Screenshots use sample data: the student, school and courses are made up.</p>

<dialog class="viewer" id="shotViewer" aria-label="Screenshot">
  <div class="viewer__bar">
    <b id="shotTitle"></b>
    <span class="viewer__spacer"></span>
    <button type="button" class="viewer__btn" data-step="-1" aria-label="Previous screenshot">‹</button>
    <button type="button" class="viewer__btn" data-step="1" aria-label="Next screenshot">›</button>
    <button type="button" class="viewer__btn" data-close aria-label="Close">✕</button>
  </div>
  <img id="shotImg" alt="" />
</dialog>

<script is:inline define:vars={{ items: shots.map((s, i) => ({ src: full[i].src, title: s.title, alt: `${s.title}: ${s.text}` })) }}>
  const viewer = document.getElementById('shotViewer');
  const img = document.getElementById('shotImg');
  const title = document.getElementById('shotTitle');
  let at = 0;
  const show = (i) => {
    at = (i + items.length) % items.length;
    img.src = items[at].src;
    img.alt = items[at].alt;
    title.textContent = items[at].title;
  };
  document.querySelectorAll('[data-shot]').forEach((b) => b.addEventListener('click', () => {
    show(Number(b.dataset.shot));
    viewer.showModal();
  }));
  viewer.addEventListener('click', (e) => {
    const step = e.target.closest('[data-step]');
    if (step) return show(at + Number(step.dataset.step));
    if (e.target.closest('[data-close]') || e.target === viewer) viewer.close();
  });
  viewer.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') show(at + 1);
    else if (e.key === 'ArrowLeft') show(at - 1);
  });
</script>

<style>
  .gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .shot { margin: 0; display: grid; gap: 12px; align-content: start; min-width: 0; }
  .shot--feature { grid-column: 1 / -1; }
  .shot__open { display: block; width: 100%; padding: 0; border: 1px solid var(--border); border-radius: var(--radius-sm); overflow: hidden; background: var(--surface); cursor: zoom-in; box-shadow: var(--shadow-sm); transition: transform 0.15s, box-shadow 0.15s; }
  .shot__open:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .shot--feature .shot__open { border-radius: var(--radius); box-shadow: var(--shadow); }
  .shot__open :global(img) { width: 100%; height: auto; }
  figcaption { display: grid; gap: 2px; }
  figcaption b { font-size: 16px; }
  figcaption span { color: var(--muted); font-size: 14.5px; }
  figcaption small { color: var(--accent); font-size: 12.5px; font-weight: 700; }
  .shot--feature figcaption { text-align: center; justify-items: center; }
  .gallery__note { margin-top: 24px; color: var(--muted); font-size: 13px; text-align: center; }

  .viewer { width: min(1400px, 100vw - 32px); max-height: calc(100vh - 32px); padding: 0; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface); color: var(--text); overflow: hidden; }
  .viewer::backdrop { background: rgba(10, 10, 20, 0.7); }
  .viewer__bar { display: flex; align-items: center; gap: 8px; padding: 10px 12px 10px 18px; border-bottom: 1px solid var(--border); }
  .viewer__spacer { flex: 1; }
  .viewer__btn { width: 36px; height: 36px; border-radius: 50%; border: 1px solid var(--border); background: var(--surface-2); color: var(--text); font: inherit; font-size: 18px; line-height: 1; cursor: pointer; }
  .viewer__btn:hover { border-color: var(--primary); }
  .viewer img { display: block; width: 100%; height: auto; max-height: calc(100vh - 100px); object-fit: contain; background: var(--surface-2); }

  @media (max-width: 980px) { .gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 720px) { .gallery { grid-template-columns: minmax(0, 1fr); } }
</style>
