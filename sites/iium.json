  "logo": "iium/logo.png",
  "hosts": ["italeemc.iium.edu.my", "italeemc-arc.iium.edu.my", "italeem.iium.edu.my"],

  "sites": [
    { "label": "Current session", "url": "https://italeemc.iium.edu.my" },
    { "label": "2025 archive", "url": "https://italeemc.iium.edu.my/2025" },
