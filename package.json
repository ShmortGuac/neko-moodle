{
  "name": "neko",
  "productName": "NEKO",
  "version": "0.1.3",
  "description": "NEKO is a Moodle Client for desktops with supports for themes and customizability.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "license": "GPL-3.0-or-later",
  "author": {
    "name": "ShmortGuac"
  },
  "repository": "github:ShmortGuac/neko-moodle",
  "build": {
    "appId": "io.github.shmortguac.neko",
    "productName": "NEKO",
    "directories": {
      "output": "dist"
    },
    "asar": false,
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum",
    "afterPack": "build/after-pack.js",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "LICENSE",
      "src/**",
      "renderer/**",
      "build/icon.*",
      "themes/README.md",
      "themes/default-light/**",
      "themes/default-dark/**",
      "themes/sakura/**",
      "themes/forest/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NEKO-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NEKO-${version}-portable.${ext}"
    }
  }
}
